# Export these in your shell or explicitly load a trusted copy; .env is not auto-loaded.
# Never commit .env or credentials. Global mock mode overrides all agent selectors.
LLM_MODE=mock

# IDs from src/interview_prep/llm/models.json, used when LLM_MODE=live.
# Override the assignments in src/interview_prep/agents/agents.json.
LLM_QUESTION_GENERATOR=mock
LLM_ANSWER_EVALUATOR=mock
LLM_FEEDBACK=mock
# Network timeout per provider operation; positive finite seconds.
LLM_TIMEOUT_SECONDS=30
# Seconds between waiting updates when a progress callback is attached; 0 disables periodic updates.
LLM_PROGRESS_INTERVAL_SECONDS=10
# Metrics is deterministic Python and has no model selector.

# Only needed when selecting an OpenAI model. No credentials are needed for mocks/Ollama.
OPENAI_API_KEY=

# Optional application logs and OpenTelemetry traces; no account needed for console export.
# Logs, console traces, and progress updates use stderr; practice content stays on stdout.
INTERVIEW_PREP_LOG_LEVEL=WARNING
# off | console | otlp; console requires pip install -e ".[telemetry]".
INTERVIEW_PREP_TELEMETRY=off
# Only for an explicitly selected OTLP collector (not needed for console traces).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
